# github IP range
if nft list chain ip qubes custom-input >/dev/null; then
  nft add rule ip qubes custom-input ip saddr { "9.234.106.48/28", "9.234.98.160/28", "9.234.98.176/28", "192.30.252.0/22", "185.199.108.0/22", "140.82.112.0/20", "143.55.64.0/20" } tcp dport 80 accept
else
  echo "no custom-input nft?!"
  exit 1
fi

cp /rw/config/webhooks.nginx /etc/nginx/default.d/webhooks.conf
cp /home/user/webhooks/webhooks.service /etc/systemd/system/webhooks.service

mkdir -p /run/webhooks
chown user:nginx /run/webhooks

systemctl daemon-reload
systemctl --no-block start webhooks.service
systemctl --no-block start nginx.service
